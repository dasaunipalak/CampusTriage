OPENAI_API_KEY=
OPENAI_MODEL=
ANALYZER_MODE=
AI_TIMEOUT_MS=
PORT=
DB_PATH=

# Student sign-in: console prints OTPs; change to smtp for real email delivery.
OTP_EMAIL_SENDER=console
# SMTP_PORT=587 uses STARTTLS; SMTP_PORT=465 uses SSL/TLS.
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM="CampusTriage <no-reply@example.invalid>"
SESSION_SECRET=replace-with-a-long-random-secret
